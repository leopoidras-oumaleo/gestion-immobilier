<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="1_init_apartment" author="Oumaleo">
        <createTable tableName="apartment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="city" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="square_meters" type="DOUBLE">
                <constraints nullable="false"/>
            </column>
            <column name="purchase_price" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="construction_year" type="INTEGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2_add_apartment_financial_fields" author="Oumaleo">
        <addColumn tableName="apartment">
            <column name="down_payment" type="INTEGER"/>
            <column name="notary_fees" type="INTEGER"/>
            <column name="broker_fees" type="INTEGER"/>
            <column name="file_fees" type="INTEGER"/>
            <column name="guarantee_fees" type="INTEGER"/>
            <column name="property_tax" type="INTEGER"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
